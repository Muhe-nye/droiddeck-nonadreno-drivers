+static void test_reattached(void) {
+    struct surface first, second; struct wl_resource r;
+    struct dmabuf_buffer *b = init_buffer(&first, &r);
+    g_release_timer_fd = 123; g_refresh_ns = 100000;
+    drop_dmabuf(&first, 1);
+    second = (struct surface){.dmabuf = &r, .dmabuf_buf = b};
+    ++b->refs;
+    second.dmabuf_destroy.notify = on_dmabuf_destroyed;
+    wl_resource_add_destroy_listener(&r, &second.dmabuf_destroy);
+    drop_dmabuf(&second, 1);
+    assert(first.releases_pending + second.releases_pending == 1);
+    fire_timer();
+    assert(r.releases == 1 && g_pending_releases.next == &g_pending_releases);
+    assert(!first.releases_pending && !second.releases_pending);
+    destroy_resource(&r);
+}
+
+static void test_immediate_after_queued(void) {
+    struct surface s; struct wl_resource r;
+    init_buffer(&s, &r);
+    g_release_timer_fd = 123; g_refresh_ns = 100000;
+    drop_dmabuf(&s, 1);
+    assert(s.releases_pending == 1);
+    droiddeck_release_buffer(NULL, &r, 0, now_ns());
+    assert(r.releases == 1 && !s.releases_pending && g_pending_releases.next == &g_pending_releases);
+    fire_timer();
+    assert(r.releases == 1);
+    destroy_resource(&r);
+}
+
+static void test_still_shown(void) {
+    struct surface s; struct wl_resource r;
+    init_buffer(&s, &r);
+    g_release_timer_fd = 123; g_refresh_ns = 100000;
+    drop_dmabuf(&s, 1);
+    shown_buffer = &r;
+    fire_timer();
+    assert(!r.releases && !s.releases_pending);
+    shown_buffer = NULL;
+    release_buffer(&s, &r, now_ns());
+    fire_timer();
+    assert(r.releases == 1 && !s.releases_pending);
+    destroy_resource(&r);
+}
