+    def test_immediate_release_consumes_an_older_queued_release(self):
+        self.run_scenario('immediate-after-queued')
+
+    def test_buffer_still_shown_is_not_released_by_timer(self):
+        self.run_scenario('still-shown')
+
 
 if __name__ == '__main__':
     unittest.main()
