@@ -0,0 +1,117 @@
+"""Exercise real attach/trace functions with a recording protocol endpoint."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+from test_vk_pending_completion import function
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = ROOT / 'app/src/main/cpp/waylandcomp/src/compositor.c'
+
+HARNESS = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdarg.h>
+#include <string.h>
+#include <unistd.h>
+struct wl_list { struct wl_list *prev, *next; };
+struct wl_client { int id; };
+struct wl_resource;
+struct wl_listener { struct wl_list link; void (*notify)(struct wl_listener *, void *); };
+struct wl_resource { uint32_t id; struct wl_client *client; void *data; };
+struct surface {
+    struct wl_resource *pending_buffer;
+    struct wl_listener pending_buffer_destroy;
+    int pending_attach;
+};
+static unsigned warnings;
+static void wl_list_init(struct wl_list *l) { l->next = l->prev = l; }
+static void wl_list_remove(struct wl_list *l) { l->next->prev = l->prev; l->prev->next = l->next; }
+static uint32_t wl_resource_get_id(struct wl_resource *r) { return r->id; }
+static struct wl_client *__attribute__((unused)) wl_resource_get_client(struct wl_resource *r) { return r->client; }
+static void *wl_resource_get_user_data(struct wl_resource *r) { return r->data; }
+static void wl_resource_add_destroy_listener(struct wl_resource *r, struct wl_listener *l) {
+    (void)r; wl_list_init(&l->link);
+}
+static void on_pending_buffer_destroyed(struct wl_listener *l, void *data) { (void)l; (void)data; }
+static int no_adreno(const char *p, int mode) { (void)p; (void)mode; return -1; }
+#define access no_adreno
+static void droiddeck_log(const char *tag, const char *fmt, ...) {
+    (void)tag;
+    if (strstr(fmt, "DOUBLE release")) ++warnings;
+}
+/* PRODUCTION_FUNCTIONS */
+int main(int argc, char **argv) {
+    assert(argc == 2);
+    (void)buf_trace_attach;
+    (void)wl_resource_get_client;
+    struct wl_client a = {1}, b = {2};
+    struct surface s = {0};
+    struct wl_resource sr = {.data = &s};
+    struct wl_resource first = {.id = 74, .client = &a};
+    struct wl_resource second = {.id = 74, .client = &b};
+    if (!strcmp(argv[1], "reattach")) {
+        surface_attach(&a, &sr, &first, 0, 0);
+        buf_trace_release(&first, 732);
+        surface_attach(&a, &sr, &first, 0, 0);
+        buf_trace_release(&first, 732);
+        assert(!warnings);
+    } else if (!strcmp(argv[1], "clients")) {
+        buf_trace_attach(&first);
+        buf_trace_release(&first, 1);
+        buf_trace_attach(&second);
+        buf_trace_release(&first, 1);
+        assert(warnings == 1);
+        buf_trace_release(&second, 1);
+        assert(warnings == 1);
+    } else if (!strcmp(argv[1], "duplicate")) {
+        surface_attach(&a, &sr, &first, 0, 0);
+        buf_trace_release(&first, 1);
+        buf_trace_release(&first, 1);
+        assert(warnings == 1);
+    } else assert(0);
+    return 0;
+}
+'''
+
+
+class BufferReleaseTraceTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cc = shutil.which(os.environ.get('CC', 'cc'))
+        if not cc:
+            raise AssertionError('C compiler required')
+        source = Path(os.environ.get('DROIDDECK_BUFFER_TRACE_SOURCE', SOURCE)).read_text()
+        start = source.index('static int g_buf_trace =')
+        end = source.index('#define send_buffer_release', start)
+        body = source[start:end] + function(source, 'surface_attach')
+        cls.tmp = tempfile.TemporaryDirectory(prefix='droiddeck-buffer-trace-')
+        cls.addClassCleanup(cls.tmp.cleanup)
+        probe = Path(cls.tmp.name) / 'probe.c'
+        probe.write_text(HARNESS.replace('/* PRODUCTION_FUNCTIONS */', body))
+        cls.binary = probe.with_suffix('')
+        built = subprocess.run([cc, '-std=c11', '-Wall', '-Wextra', '-Werror',
+                                '-Wno-unused-parameter', '-UNDEBUG', str(probe),
+                                '-o', str(cls.binary)], capture_output=True, text=True)
+        if built.returncode:
+            raise AssertionError(built.stdout + built.stderr)
+
+    def check_case(self, name):
+        result = subprocess.run([str(self.binary), name], capture_output=True, text=True, timeout=10)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    def test_shm_and_pixel_reattach_is_not_a_duplicate_release(self):
+        self.check_case('reattach')
+
+    def test_buffer_ids_are_scoped_to_their_client(self):
+        self.check_case('clients')
+
+    def test_actual_duplicate_is_still_reported(self):
+        self.check_case('duplicate')
+
+
+if __name__ == '__main__':
+    unittest.main()
